<?xml version='1.0' encoding='utf-8'?>
<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../Schema/OpenSCENARIO.xsd">
  <FileHeader author="MORAI:scenario-module-team" date="2026-03-31T10:00:00" description="B_Action Example: SpeedAction rate linear" revMajor="1" revMinor="2" />
  <ParameterDeclarations>
    <ParameterDeclaration name="init_ego_speed_mps" parameterType="double" value="0.0" />
    <ParameterDeclaration name="init_npc1_speed_mps" parameterType="double" value="0.0" />
    <ParameterDeclaration name="init_npc2_speed_mps" parameterType="double" value="0.0" />
    <ParameterDeclaration name="start_ego_speed_mps" parameterType="double" value="13.88" />
    <ParameterDeclaration name="start_npc1_speed_mps" parameterType="double" value="13.88" />
    <ParameterDeclaration name="target_offset_1" parameterType="double" value="2.5" />
    <ParameterDeclaration name="target_offset_2" parameterType="double" value="0.0" />
    <ParameterDeclaration name="trigger_time_s" parameterType="double" value="4.5" />
    <ParameterDeclaration name="timeout_s" parameterType="double" value="20.0" />
  </ParameterDeclarations>
  <VariableDeclarations>
    <VariableDeclaration name="moraiMap" variableType="string" value="KATRI" />
    <VariableDeclaration name="evaluation" variableType="string" value="none" />
  </VariableDeclarations>
  <CatalogLocations />
  <RoadNetwork>
    <LogicFile filepath="KATRI" />
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="Ego">
      <Vehicle mass="2100.0" model3d="HD Ioniq5" name="Ego" role="none" vehicleCategory="car">
        <BoundingBox>
          <Center x="1.5275" y="0.0" z="0.0" />
          <Dimensions height="1.605" length="4.635" width="1.89" />
        </BoundingBox>
        <Performance maxAcceleration="0.0" maxAccelerationRate="0.0" maxDeceleration="0.0" maxDecelerationRate="0.0" maxSpeed="0.0" />
        <Axles>
          <FrontAxle maxSteering="0.0" positionX="2.7" positionZ="0.0" trackWidth="0.0" wheelDiameter="0.0" />
          <RearAxle maxSteering="0.0" positionX="0.0" positionZ="0.0" trackWidth="0.0" wheelDiameter="0.0" />
        </Axles>
        <Properties>
          <Property name="MotionModel" value="Dynamics" />
          <Property name="AgentType" value="Ego" />
        </Properties>
      </Vehicle>
      <ObjectController>
        <Controller controllerType="all" name="Preset">
          <Properties>
            <Property name="name" value="Off" />
          </Properties>
        </Controller>
      </ObjectController>
    </ScenarioObject>
    <ScenarioObject name="NPC_1">
      <Vehicle name="gv_car_hdioniq5_2023" vehicleCategory="car" role="civil" mass="2100" model3d="HD Ioniq5">
        <BoundingBox>
          <Center x="1.5275" y="0.0" z="0.0" />
          <Dimensions height="1.605" length="4.635" width="1.890" />
        </BoundingBox>
        <Performance maxAcceleration="4.0" maxDeceleration="8.0" maxSpeed="69.444" />
        <Axles>
          <FrontAxle maxSteering="0" positionX="3.0" positionZ="0" trackWidth="0" wheelDiameter="0" />
          <RearAxle maxSteering="0" positionX="0.0" positionZ="0" trackWidth="0" wheelDiameter="0" />
        </Axles>
        <Properties>
          <Property name="check_tl" value="false" />
          <Property name="apply_acc" value="false" />
          <Property name="MotionModel" value="Kinematic" />
          <Property name="external_control" value="false" />
        </Properties>
      </Vehicle>
      <ObjectController>
        <Controller controllerType="all" name="Preset">
          <Properties>
            <Property name="name" value="Standard" />
          </Properties>
        </Controller>
      </ObjectController>
      <ObjectController>
        <Controller controllerType="longitudinal" name="Longitudinal">
          <Properties>
            <Property name="group" value="LongitudinalCarFollowing" />
            <Property name="model" value="Idm" />
            <Property name="max_acceleration" value="4.0" />
            <Property name="comfort_deceleration" value="1.5" />
            <Property name="min_distance" value="3.0" />
            <Property name="time_gap" value="1.5" />
            <Property name="desired_speed" value="33.299999" />
            <Property name="acceleration_exponent" value="4.0" />
            <Property name="traffic_lights" value="false" />
          </Properties>
        </Controller>
      </ObjectController>
      <ObjectController>
        <Controller controllerType="lateral" name="Lateral">
          <Properties>
            <Property name="group" value="LateralDiscretionaryLaneChange" />
            <Property name="model" value="Mobil" />
            <Property name="changing_threshold" value="1.0" />
            <Property name="politeness_factor" value="0.5" />
            <Property name="bias_for_right_lane" value="0.2" />
            <Property name="safe_deceleration" value="-3.0" />
          </Properties>
        </Controller>
      </ObjectController>
    </ScenarioObject>
    <ScenarioObject name="NPC_2">
      <Vehicle name="gv_car_hdioniq5_2023" vehicleCategory="car" role="civil" mass="2100" model3d="HD Ioniq5">
        <BoundingBox>
          <Center x="1.5275" y="0.0" z="0.0" />
          <Dimensions height="1.605" length="4.635" width="1.890" />
        </BoundingBox>
        <Performance maxAcceleration="4.0" maxDeceleration="8.0" maxSpeed="69.444" />
        <Axles>
          <FrontAxle maxSteering="0" positionX="3.0" positionZ="0" trackWidth="0" wheelDiameter="0" />
          <RearAxle maxSteering="0" positionX="0.0" positionZ="0" trackWidth="0" wheelDiameter="0" />
        </Axles>
        <Properties>
          <Property name="check_tl" value="false" />
          <Property name="apply_acc" value="false" />
          <Property name="MotionModel" value="Kinematic" />
          <Property name="external_control" value="false" />
        </Properties>
      </Vehicle>
      <ObjectController>
        <Controller controllerType="all" name="Preset">
          <Properties>
            <Property name="name" value="Standard" />
          </Properties>
        </Controller>
      </ObjectController>
      <ObjectController>
        <Controller controllerType="longitudinal" name="Longitudinal">
          <Properties>
            <Property name="group" value="LongitudinalCarFollowing" />
            <Property name="model" value="Idm" />
            <Property name="max_acceleration" value="4.0" />
            <Property name="comfort_deceleration" value="1.5" />
            <Property name="min_distance" value="3.0" />
            <Property name="time_gap" value="1.5" />
            <Property name="desired_speed" value="33.299999" />
            <Property name="acceleration_exponent" value="4.0" />
            <Property name="traffic_lights" value="false" />
          </Properties>
        </Controller>
      </ObjectController>
      <ObjectController>
        <Controller controllerType="lateral" name="Lateral">
          <Properties>
            <Property name="group" value="LateralDiscretionaryLaneChange" />
            <Property name="model" value="Mobil" />
            <Property name="changing_threshold" value="1.0" />
            <Property name="politeness_factor" value="0.5" />
            <Property name="bias_for_right_lane" value="0.2" />
            <Property name="safe_deceleration" value="-3.0" />
          </Properties>
        </Controller>
      </ObjectController>
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <Private entityRef="Ego">
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="$init_ego_speed_mps" />
                </SpeedActionTarget>
                <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="step" value="0" />
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
          <PrivateAction>
            <TeleportAction>
              <Position>
                <WorldPosition x="-2743.928" y="1173.635" z="28.463" h="1.572939" p="0" r="0" />
              </Position>
            </TeleportAction>
          </PrivateAction>
        </Private>
        <Private entityRef="NPC_1">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition laneId="A2256W000140" offset="0" roadId="WSR4008165" s="20.0">
                  <Orientation type="relative" h="0" p="0" r="0" />
                </LanePosition>
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="$init_npc1_speed_mps" />
                </SpeedActionTarget>
                <SpeedActionDynamics dynamicsShape="step" value="0.1" dynamicsDimension="time" />
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
        <Private entityRef="NPC_2">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition laneId="A2256W000244" offset="-1" roadId="WSR4006006" s="38.0">
                  <Orientation type="relative" h="0" p="0" r="0" />
                </LanePosition>
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="$init_npc2_speed_mps" />
                </SpeedActionTarget>
                <SpeedActionDynamics dynamicsShape="step" value="0.1" dynamicsDimension="time" />
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="Temp_Story">
      <ParameterDeclarations />
      <Act name="Temp_Act">
        <ManeuverGroup name="Temp_MG" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="Ego" />
          </Actors>
          <Maneuver name="Maneuver_OffsetChange">
            <Event name="start_vehicle" maximumExecutionCount="1" priority="override">
              <Action name="start_action">
                <PrivateAction>
                  <LongitudinalAction>
                    <SpeedAction>
                      <SpeedActionTarget>
                        <AbsoluteTargetSpeed value="$start_ego_speed_mps" />
                      </SpeedActionTarget>
                      <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="step" value="0" />
                    </SpeedAction>
                  </LongitudinalAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="EventStart_SimulationTime_3s" delay="0" conditionEdge="rising">
                    <ByValueCondition>
                      <SimulationTimeCondition value="3.0" rule="greaterThan" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
            <Event name="Event_OffsetChange_At10s" maximumExecutionCount="1" priority="override">
              <Action name="Action_LaneOffsetAction_Step">
                <PrivateAction>
                  <LateralAction>
                    <LaneOffsetAction continuous="true">
                      <LaneOffsetActionDynamics dynamicsShape="cubic" />
                      <LaneOffsetTarget>
                        <AbsoluteTargetLaneOffset value="$target_offset_1" />
                      </LaneOffsetTarget>
                    </LaneOffsetAction>
                  </LateralAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="EventStart_SimulationTime_1.5s" delay="0" conditionEdge="rising">
                    <ByValueCondition>
                      <SimulationTimeCondition value="$trigger_time_s" rule="greaterThan" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
            <Event name="Event_OffsetChange_At10s" maximumExecutionCount="1" priority="override">
              <Action name="Action_LaneOffsetAction_Step">
                <PrivateAction>
                  <LateralAction>
                    <LaneOffsetAction continuous="true">
                      <LaneOffsetActionDynamics dynamicsShape="cubic" />
                      <LaneOffsetTarget>
                        <AbsoluteTargetLaneOffset value="$target_offset_2" />
                      </LaneOffsetTarget>
                    </LaneOffsetAction>
                  </LateralAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="EventStart_SimulationTime_1.5s" delay="0" conditionEdge="rising">
                    <ByValueCondition>
                      <SimulationTimeCondition value="8.0" rule="greaterThan" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <ManeuverGroup name="MG_EnvironmentAction" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="NPC_1" />
          </Actors>
          <Maneuver name="Maneuver_EnvironmentChange">
            <Event name="start_vehicle" maximumExecutionCount="1" priority="override">
              <Action name="start_action">
                <PrivateAction>
                  <LongitudinalAction>
                    <SpeedAction>
                      <SpeedActionTarget>
                        <AbsoluteTargetSpeed value="$start_npc1_speed_mps" />
                      </SpeedActionTarget>
                      <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="step" value="0" />
                    </SpeedAction>
                  </LongitudinalAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="EventStart_SimulationTime_3s" delay="0" conditionEdge="rising">
                    <ByValueCondition>
                      <SimulationTimeCondition value="3.0" rule="greaterThan" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <StartTrigger>
          <ConditionGroup>
            <Condition name="ActStart_SimulationTime" delay="0" conditionEdge="none">
              <ByValueCondition>
                <SimulationTimeCondition value="0" rule="greaterThan" />
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
        <StopTrigger />
      </Act>
    </Story>
    <StopTrigger>
      <ConditionGroup>
        <Condition name="Time_out" delay="0" conditionEdge="none">
          <ByValueCondition>
            <SimulationTimeCondition value="$timeout_s" rule="greaterThan" />
          </ByValueCondition>
        </Condition>
      </ConditionGroup>
    </StopTrigger>
  </Storyboard>
</OpenSCENARIO>