<OpenSCENARIO>
  <FileHeader author="MORAI:scenario-module-team" date="2026-03-31T10:00:00" description="Following a Lead Vehicle - Lead(NPC) speed=30 km/h, offset=1.0 m" revMajor="1" revMinor="2" />
